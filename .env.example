# PyDective Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Google Gemini API
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_API_KEYS=AIzaSyFakeKey1,AIzaSyFakeKey2
GEMINI_API_KEY=

# Concurrency & Semaphore
MAX_CONCURRENT_PAGES_PER_PROJECT=5
MAX_WORKERS_PER_JOB=4

# Redis Configuration (Optional for dev fallback)
REDIS_URL=redis://localhost:6379/0
REDIS_CONNECT_TIMEOUT_SECONDS=0.5

# Memory Cache Limits (Fallback)
MAX_CACHE_DOCUMENTS=100
MAX_CACHE_DOCUMENT_BYTES=5242880
MAX_TOTAL_CACHE_BYTES=268435456

# Document Engine Limits & Thresholds
MAX_PAGES_PER_DOCUMENT=20
GLOBAL_DEADLINE_SECONDS=25.0
OPENCV_BYPASS_WORD_THRESHOLD=80
CATALOGAR_IMAGENES_DEFAULT=True

# Context Cache L2
L2_CACHE_MIN_TOKENS=32768
L2_CACHE_TTL_MINUTES=5

{
  "name": "pydective-frontend",
  "version": "0.1.0",
  "description": "Tailwind CSS v4 pipeline for PyDective",
  "private": true,
  "scripts": {
    "build:css": "npx @tailwindcss/cli -i app/static/css/input.css -o app/static/css/styles.css --minify",
    "watch:css": "npx @tailwindcss/cli -i app/static/css/input.css -o app/static/css/styles.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "tailwindcss": "^4.0.0"
  }
}
